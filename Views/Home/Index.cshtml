@{
    ViewData["Title"] = "Home";
}

<section class="welcome">
    <div>
        <p class="eyebrow">University Library</p>
        <h1>Find a book. Lend it. Get it back.</h1>
        <p class="welcome-lead">One place for the catalogue, the people who borrow from it, and the notes the staff leave for each other.</p>
        <div class="welcome-actions">
            <a asp-controller="Books" asp-action="Index" class="btn btn-maroon">Browse books</a>
            <a asp-controller="Loans" asp-action="Borrow" class="btn btn-outline-maroon">Borrow a book</a>
        </div>
    </div>
    <div class="libcard" aria-hidden="true">
        <div class="libcard-top"><span>Library card</span><span class="libcard-mark"></span></div>
        <div class="libcard-body">
            <div class="libcard-line w60"></div>
            <div class="libcard-line w40"></div>
            <div class="libcard-line w75"></div>
        </div>
        <div class="libcard-barcode"></div>
    </div>
</section>

<div class="facts-band">
    <div class="fact"><div class="fact-num">3</div><div class="fact-label">books out at a time</div></div>
    <div class="fact"><div class="fact-num">1 to 30</div><div class="fact-label">days for each loan</div></div>
    <div class="fact"><div class="fact-num">1</div><div class="fact-label">press of Return to give it back</div></div>
</div>

<h2 class="section-head">Go to</h2>
<div class="linklist">
    <a asp-controller="Books" asp-action="Index" class="linkrow">
        <span class="linkrow-name">Books</span>
        <span class="linkrow-desc">Browse and edit the catalogue</span>
        <span class="linkrow-go">Open</span>
    </a>
    <a asp-controller="Members" asp-action="Index" class="linkrow">
        <span class="linkrow-name">Members</span>
        <span class="linkrow-desc">Students, faculty and regulars</span>
        <span class="linkrow-go">Open</span>
    </a>
    <a asp-controller="Loans" asp-action="Index" class="linkrow">
        <span class="linkrow-name">Loans</span>
        <span class="linkrow-desc">Borrow and return books</span>
        <span class="linkrow-go">Open</span>
    </a>
    <a asp-controller="Notes" asp-action="Index" class="linkrow">
        <span class="linkrow-name">Notes</span>
        <span class="linkrow-desc">Reminders for the staff</span>
        <span class="linkrow-go">Open</span>
    </a>
</div>
