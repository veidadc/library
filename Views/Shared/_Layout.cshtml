@{
    // Which top-level page are we on? Used to highlight the matching menu link.
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Library</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="container topbar-inner">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index"><span class="brand-mark"></span>Library</a>
            <nav class="topnav">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="@(current == "Home" ? "active" : "")">Home</a>
                <a asp-area="" asp-controller="Books" asp-action="Index" class="@(current == "Books" ? "active" : "")">Books</a>
                <a asp-area="" asp-controller="Members" asp-action="Index" class="@(current == "Members" ? "active" : "")">Members</a>
                <a asp-area="" asp-controller="Loans" asp-action="Index" class="@(current == "Loans" ? "active" : "")">Loans</a>
                <a asp-area="" asp-controller="Notes" asp-action="Index" class="@(current == "Notes" ? "active" : "")">Notes</a>
            </nav>
        </div>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="sitefoot">
        <div class="container">&copy; 2026 Library</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
