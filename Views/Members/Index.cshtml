@model List<Member>
@{
    ViewData["Title"] = "Members";
}

<div class="pagehead">
    <div>
        <h1>Members</h1>
        <p class="pagehead-sub">@Model.Count members</p>
    </div>
    <a asp-action="Create" class="btn btn-maroon">Add a member</a>
</div>

<div class="table-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Type</th>
                <th class="right">Books out</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in Model)
            {
                <tr>
                    <td class="strong">@member.FullName</td>
                    <td class="soft">@(member.Email ?? "—")</td>
                    <td><span class="pill pill-@member.MemberType.ToLower()">@member.MemberType</span></td>
                    <td class="right"><span class="count count-@(member.OpenLoans == 0 ? "zero" : member.OpenLoans >= 3 ? "full" : "some")">@member.OpenLoans</span></td>
                    <td class="row-actions">
                        <a asp-action="Details" asp-route-id="@member.MemberId" class="rowlink">Loans</a>
                        <a asp-action="Edit" asp-route-id="@member.MemberId" class="rowlink">Edit</a>
                        <a asp-action="Delete" asp-route-id="@member.MemberId" class="rowlink rowlink-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
