@model Member
@{
    ViewData["Title"] = "Delete a member";
}

<div class="pagehead">
    <div>
        <h1>Delete a member</h1>
        <p class="pagehead-sub">This cannot be undone.</p>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="notice-box">@ViewBag.Error</div>
}

<div class="form-card danger">
    <p>Are you sure you want to delete this member?</p>
    <dl class="kv">
        <dt>Name</dt>
        <dd>@Model.FullName</dd>
        <dt>Email</dt>
        <dd>@(Model.Email ?? "—")</dd>
        <dt>Type</dt>
        <dd>@Model.MemberType</dd>
    </dl>
    <p class="fineprint">A member who has loans cannot be deleted.</p>

    <form asp-action="Delete" asp-route-id="@Model.MemberId" method="post">
        <button type="submit" class="btn btn-crimson">Delete</button>
        <a asp-action="Index" class="btn btn-quiet">Cancel</a>
    </form>
</div>
